# Copy this file to .env and fill in your own values. .env is gitignored.

# Torn API key. https://www.torn.com/preferences.php?cat=api
TORN_API_KEY=your_api_key_here

# Your faction's numeric id. Used by the skills that report on "our" faction.
TORN_FACTION_ID=00000

# Cloudflare Pages project for the dashboard hub, used by the publish skill.
# This is also the public hostname (https://<project>.pages.dev), which is why
# it is configured here rather than committed.
PAGES_PROJECT=your-pages-project
