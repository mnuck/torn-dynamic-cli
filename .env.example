# Copy this file to .env and fill in your own values. .env is gitignored.
#
# Note: in this checkout .env is delivered as a **FIFO** — an out-of-process
# secret broker writes the full payload intermittently (ls shows prw-------,
# not a regular file). An "empty" read just means the write window wasn't open:
# retry, and never "fix" it into a regular file. Real values are never committed.

# Torn API key. https://www.torn.com/preferences.php?cat=api
TORN_API_KEY=your_api_key_here

# Your faction's numeric id. Used by the skills that report on "our" faction.
TORN_FACTION_ID=00000

# Cloudflare Pages project for the dashboard hub, used by the publish skill.
# This is also the public hostname (https://<project>.pages.dev), which is why
# it is configured here rather than committed.
PAGES_PROJECT=your-pages-project

# GCP project holding the torn_rw_stats BigQuery dataset (member status history),
# used by the late-oc and oc-payout skills.
BQ_PROJECT=your-gcp-project
