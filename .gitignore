# Build output
/torn

# Environment / secrets
.env
.env*

# Cached API responses and data files (root-level only)
/*.json

# Cached/derived data used by skills (regenerable, not source)
/data/*.json

# Generated reports/dashboards (regenerable output, not source)
/generated/

# Ad-hoc analysis scripts (not part of the Go build)
*.py
# ...but skill-owned generators ARE tracked alongside their skill
!.agents/skills/**/*.py

# Python bytecode cache
__pycache__/

# Claude Code local settings (machine-specific, may contain secrets)
.claude/settings.local.json

# Claude Code local launch config (drifts per-machine/session; not shared config)
.claude/launch.json

# OMC runtime state (ephemeral)
.omc/sessions/
.omc/state/

# Cloudflare wrangler local state (created on first `publish` deploy)
.wrangler/
