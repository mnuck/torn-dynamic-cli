# Build output
/torn

# Environment / secrets
.env
.env*
!.env.example

# Cached API responses and data files (root-level only)
/*.json

# Cached/derived data used by skills (regenerable, not source).
# Everything under data/ at any depth -- data/cache/ and data/market-snapshots/
# hold multi-megabyte API dumps that would otherwise sneak in. The fetch
# scripts that produce these files ARE tracked; see data/README.md.
/data/**/*.json
/data/**/*.jsonl
/data/**/*.csv
/data/**/*.log

# Generated reports/dashboards (regenerable output, not source)
/generated/

# Ad-hoc analysis scripts (not part of the Go build)
*.py
# ...but skill-owned generators ARE tracked alongside their skill
!.agents/skills/**/*.py
# ...and so is the deployed capture script (deploy/configmap.yaml is generated
# from it, so it has to be tracked or the ConfigMap has no source)
!deploy/*.py

# Python bytecode cache
__pycache__/

# Claude Code local settings (machine-specific, may contain secrets)
.claude/settings.local.json

# Claude Code local launch config (drifts per-machine/session; not shared config)
.claude/launch.json

# OMC runtime state (ephemeral)
.omc/sessions/
.omc/state/

# Cloudflare wrangler local state (created on first `publish` deploy)
.wrangler/

# macOS Finder metadata
.DS_Store
